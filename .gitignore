# LICENSE and CHANGELOG are copied into each package at pack time
# (see the publish workflow and scripts/verify-pack.mjs)
packages/*/LICENSE
packages/*/CHANGELOG.md

# Compiled output must never sit beside the sources - tsc writes to dist/.
# (These were committed into src/ historically and the test suite scored them
# instead of the TypeScript.)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.map
